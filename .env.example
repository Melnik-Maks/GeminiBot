# Copy to .env; never commit the real token.
BOT_TOKEN=
# Numeric Telegram IDs separated by commas. Each admin must /start the bot.
ADMIN_IDS=
# Public Telegram username for the direct contact button.
ADMIN_USERNAME=
PAYMENT_CARD=
PAYMENT_RECIPIENT=
PAYMENT_BANK=
PRICE_UAH=200
DELIVERY_TIME=1–5 хв
DATABASE_PATH=data/bot.sqlite3
# Exact allowed hosts, comma separated. Empty = any public HTTPS host.
GIFT_ALLOWED_HOSTS=
SALES_OPEN=false
